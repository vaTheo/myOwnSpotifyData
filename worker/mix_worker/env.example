# mix-worker settings. The command line form reads worker/.env (copy this file);
# the packaged executable reads mix-worker.env beside itself (it writes this
# template on its first start). The environment overrides the file.
# Only the two public values of the app's .env are required; nothing here is a secret.

SUPABASE_URL=                      # the project URL, https://<ref>.supabase.co (required)
SUPABASE_KEY=                      # the publishable key, sb_publishable_... (required, public)

WORKER_NAME=                       # shown on the phone as "Running on <name>"; default: this computer's hostname
WORKER_SESSION_FILE=               # the sign-in session; default ~/.config/myownspotifydata-worker/session.json (%APPDATA% on Windows), or session.json beside the executable when one exists there
WORKER_WORK_DIR=                   # one sub-folder per request, deleted when it ends; default ~/.cache/myownspotifydata-worker (%LOCALAPPDATA% on Windows)
WORKER_JSON_DIR=                   # the kept results, "<date> <title> [<id>].json"; default ~/Music/mix-worker
WORKER_LOG_FILE=                   # one line per step; default <WORKER_WORK_DIR>/worker.log
WORKER_FFMPEG=                     # override only: another ffmpeg to use; default the one packaged with the worker
WORKER_YTDLP_COOKIES=              # a Netscape cookies file for platforms that need a login; default none
WORKER_PROXY=                      # HTTP proxy for the recognition calls only; default none

WORKER_STALE_SECONDS=21600         # a request running longer than this is taken again by the next run (6 h)
WORKER_POLL_SECONDS=60             # `run --watch`: seconds between two looks at the queue
WORKER_HEARTBEAT_SECONDS=30        # `run --watch`: an "alive" line this often while waiting
WORKER_MAX_DURATION_SECONDS=0      # 0 = no limit (default); otherwise longer sets are refused before the download
WORKER_PROBE_STEP_SECONDS=15       # one probe every N seconds; with 12 s probes, 15 hears 80 % of the set, 12 all of it
WORKER_PROBE_SECONDS=12            # length of each probe sent to Shazam (2 to 12; Shazam fingerprints 12 s at most)
WORKER_COOLDOWN_SECONDS=3.0        # sleep before every recognition call, plus a random 0-50 %; doubled after each rate limit (30 s at most)
WORKER_RATE_LIMIT_PAUSE_SECONDS=300  # pause after a "rate limited" answer; the 2nd pause is twice as long, the 3rd three times
WORKER_RATE_LIMIT_PAUSES=3         # pauses allowed per set; one more refusal fails the request
WORKER_SHAZAM_DEVICE=android       # the phone Shazam sees: android or iphone (the library's own default, refused sooner)
WORKER_MAX_SKEW=0.1                # reject a match more than 10 % off in pitch or speed; DJs pitch tracks a few %, 0 disables
WORKER_MERGE_GAP_SECONDS=180       # the same track heard again within this gap extends the row
WORKER_RESULT_MAX_BYTES=900000     # larger results fail with "Result too large"
