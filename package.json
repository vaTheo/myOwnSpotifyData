    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "preact": "^10.29.8"
